-- speleo_loc
--
-- All syncable tables use BLOB UUID primary keys (see `lib/utils/uuid.dart`
-- for the Dart value type and the `UuidConverter` TypeConverter). Primary
-- keys are named `uuid`; foreign keys are named `<entity>_uuid`.
--
-- Audit columns on every syncable table:
--   created_by_user_uuid        BLOB REFERENCES users(uuid)  -- immutable after insert
--   last_modified_by_user_uuid  BLOB REFERENCES users(uuid)  -- rewritten on each update
-- The device_uuid and current_user_uuid are stored in `configurations` as
-- well-known key/value entries.
--
-- `configurations` keeps an INTEGER primary key because it is local-only and
-- not synced across devices. Local-only means: absent from the sync-archive
-- table registry and from the archive import/export configs, so no exporter
-- has to remember to skip it. The other local-only tables are
-- `ruuvi_sensor_history` and the `silexgis_*` tables at the end of this
-- file.
--
-- `place_code_identifier` (PCI) and `qr_code_resource_identifier` (QCRI)
-- are user-facing alphanumeric identifiers on cave_places. PCI is the
-- human-meaningful code printed on labels and shown in UI; QCRI is the
-- identifier embedded in QR codes (either equal to PCI or a salted hash of
-- it). They are generated by the place-code-identifier service
-- (see lib/services/place_code/). On sync, last-writer-wins.
--
-- `change_log` / `change_log_field` record structured audit history for
-- every repository write. They are synced across devices and auto-purged
-- locally based on the retention threshold in `configurations`.

import 'package:speleoloc/utils/uuid.dart';

-- Table: users
-- Synced. `username` is treated as the natural key on sync: two user rows
-- with the same username auto-merge (keep earliest created_at, remap FKs).
CREATE TABLE IF NOT EXISTS users (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    username                    TEXT(100) NOT NULL UNIQUE,
    first_name                  TEXT(100),
    last_name                   TEXT(100),
    details                     TEXT,
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid)
);

-- Table: cave_areas
CREATE TABLE IF NOT EXISTS cave_areas (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    title                       TEXT(255) NOT NULL,
    description                 TEXT,
    cave_uuid                   BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES caves(uuid),
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(title, cave_uuid) ON CONFLICT ROLLBACK
);

-- Table: cave_entrances (not used)
CREATE TABLE IF NOT EXISTS cave_entrances (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    cave_uuid                   BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES caves(uuid),
    surface_place_uuid          BLOB MAPPED BY `const UuidConverter()` REFERENCES surface_places(uuid),
    is_main_entrance            INTEGER,
    title                       TEXT(255),
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(cave_uuid, title) ON CONFLICT ROLLBACK
);

-- Table: cave_place_to_raster_map_definitions
CREATE TABLE IF NOT EXISTS cave_place_to_raster_map_definitions (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    x_coordinate                INTEGER,
    y_coordinate                INTEGER,
    cave_place_uuid             BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES cave_places(uuid),
    raster_map_uuid             BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES raster_maps(uuid),
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(cave_place_uuid, raster_map_uuid) ON CONFLICT ROLLBACK
);

-- Table: cave_places
CREATE TABLE IF NOT EXISTS cave_places (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    title                       TEXT(80) NOT NULL,
    description                 TEXT,
    cave_uuid                   BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES caves(uuid),
    place_code_identifier       TEXT(64), -- alphanumeric PCI, generated by the configured assignment strategy
    qr_code_resource_identifier TEXT(64), -- alphanumeric QCRI embedded in QR codes (= PCI or hash(PCI+salt))
    cave_area_uuid              BLOB MAPPED BY `const UuidConverter()` REFERENCES cave_areas(uuid),
    --todo: redesign - SQLite stores everything as REAL (the actual DB schema confirms this). The NUMERIC(p,s) type affinity in SQLite is effectively ignored — scale/precision are cosmetic
    latitude                    NUMERIC(10, 8),
    longitude                   NUMERIC(11, 8),
    altitude                    NUMERIC(7, 2),
    depth_in_cave               NUMERIC(7, 2),
    is_entrance                 INTEGER NOT NULL DEFAULT 0,
    is_main_entrance            INTEGER NOT NULL DEFAULT 0,
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(title, cave_uuid, cave_area_uuid) ON CONFLICT ROLLBACK
);

-- Title uniqueness for places without a cave area. The UNIQUE above never
-- fires when cave_area_uuid is NULL (SQLite treats NULLs as distinct), so
-- this partial index closes that gap. Constraint-bearing, so it lives here
-- for fresh installs; the v16→v17 migration renames existing twins and
-- creates the same index for upgraders.
CREATE UNIQUE INDEX IF NOT EXISTS idx_cave_places_title_no_area
    ON cave_places(title, cave_uuid) WHERE cave_area_uuid IS NULL;

-- Table: caves
CREATE TABLE IF NOT EXISTS caves (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    title                       TEXT(50) NOT NULL,
    description                 TEXT,
    surface_area_uuid           BLOB MAPPED BY `const UuidConverter()` REFERENCES surface_areas(uuid),
    cave_local_index            TEXT(32), -- short identifier used by per-cave sequential PCI strategy
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(title, surface_area_uuid) ON CONFLICT ROLLBACK
);

-- Table: documentation_files
CREATE TABLE IF NOT EXISTS documentation_files (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    title                       TEXT(50) NOT NULL,
    description                 TEXT,
    file_name                   TEXT(255) NOT NULL,
    file_size                   INTEGER NOT NULL,
    file_hash                   TEXT(64),
    file_type                   TEXT(25) NOT NULL,
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(title, file_name, file_size, file_hash) ON CONFLICT ROLLBACK
);

-- Table: documentation_files_to_geofeatures
CREATE TABLE IF NOT EXISTS documentation_files_to_geofeatures (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    geofeature_uuid             BLOB MAPPED BY `const UuidConverter()`,
    geofeature_type             TEXT(20) NOT NULL,
    documentation_file_uuid     BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES documentation_files(uuid),
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(geofeature_uuid, geofeature_type, documentation_file_uuid) ON CONFLICT ROLLBACK
);

-- Table: configurations (NOT synced, keeps INTEGER PK, except for is_synced=1 archive entries)
-- Well-known keys include (but are not limited to):
--   'device_uuid'           -- this device's persistent UUIDv7 (hex)
--   'current_user_uuid'     -- the currently selected user's UUID (hex)
--   'change_log_retention_days'  -- default 365
--   'tombstone_retention_days'   -- default 365
CREATE TABLE IF NOT EXISTS configurations (
    id          INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title       TEXT(255) NOT NULL UNIQUE,
    value       TEXT,
    is_synced   INTEGER NOT NULL DEFAULT 0, -- when 1, the row is exported by archive sync
    created_at  INTEGER,
    updated_at  INTEGER
);

-- Table: raster_maps
CREATE TABLE IF NOT EXISTS raster_maps (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    title                       TEXT NOT NULL,
    map_type                    TEXT(20) NOT NULL CHECK(map_type IN ('plane view', 'projected profile', 'extended profile', 'other')),
    file_name                   TEXT(255) NOT NULL,
    file_hash                   TEXT(64),     -- SHA-256 hex digest of the image file; NULL when not yet computed
    file_size                   INTEGER,      -- image file size in bytes; NULL when not yet computed
    order_index                 INTEGER NOT NULL DEFAULT 0,  -- display order within a cave (0-based, lower = earlier)
    cave_uuid                   BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES caves(uuid),
    cave_area_uuid              BLOB MAPPED BY `const UuidConverter()` REFERENCES cave_areas(uuid),
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(title, map_type, cave_uuid) ON CONFLICT ROLLBACK,
    UNIQUE(file_name, map_type, cave_uuid) ON CONFLICT ROLLBACK
);

-- Table: surface_places (not used)
CREATE TABLE IF NOT EXISTS surface_places (
    uuid                                BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    title                               TEXT(255) NOT NULL,
    description                         TEXT,
    type                                TEXT(20),
    surface_place_qr_code_identifier    INTEGER DEFAULT NULL UNIQUE,
    latitude                            NUMERIC(10, 8),
    longitude                           NUMERIC(11, 8),
    created_at                          INTEGER,
    updated_at                          INTEGER,
    deleted_at                          INTEGER,
    created_by_user_uuid                BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid          BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid)
);

-- Table: surface_areas
CREATE TABLE IF NOT EXISTS surface_areas (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    title                       TEXT(255) NOT NULL UNIQUE,
    description                 TEXT,
    general_area_identifier     TEXT(32), -- short identifier used by per-area sequential PCI strategy

    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid)
);

-- Table: cave_trips
CREATE TABLE IF NOT EXISTS cave_trips (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    cave_uuid                   BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES caves(uuid),
    title                       TEXT(255) NOT NULL,
    description                 TEXT,
    trip_started_at             INTEGER NOT NULL,
    trip_ended_at               INTEGER,
    log                         TEXT,
    -- When the log first fell behind the trip's recorded points: set when
    -- points change without the log being regenerated, cleared when it is
    -- regenerated or the user keeps it as written. Null means the log is
    -- as its points would render it, or has been accepted as it stands.
    log_stale_since             INTEGER,
    -- Who went, as the user typed it: names separated by commas.
    participants                TEXT,
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    device_uuid                 BLOB MAPPED BY `const UuidConverter()`,
    UNIQUE(title, cave_uuid, created_by_user_uuid, device_uuid) ON CONFLICT ROLLBACK
);

-- Table: cave_trip_points
CREATE TABLE IF NOT EXISTS cave_trip_points (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    cave_trip_uuid              BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES cave_trips(uuid),
    cave_place_uuid             BLOB MAPPED BY `const UuidConverter()` REFERENCES cave_places(uuid),
    scanned_at                  INTEGER NOT NULL,
    notes                       TEXT,
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(cave_trip_uuid, cave_place_uuid, scanned_at) ON CONFLICT ROLLBACK
);

-- Table: documentation_files_to_cave_trips
CREATE TABLE IF NOT EXISTS documentation_files_to_cave_trips (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    documentation_file_uuid     BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES documentation_files(uuid),
    cave_trip_uuid              BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES cave_trips(uuid),
    created_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(documentation_file_uuid, cave_trip_uuid) ON CONFLICT ROLLBACK
);

-- Table: documentation_files_to_cave_trip_points
-- Binds a document (in practice a photo or video) to the individual track
-- point it was captured at, which the doc-to-trip link cannot express: a
-- trip visits the same place more than once, and "which stop was this
-- picture taken at" is the question the media import exists to answer.
-- Shaped exactly like documentation_files_to_cave_trips (no updated_at, so
-- sync LWW falls back to created_at).
CREATE TABLE IF NOT EXISTS documentation_files_to_cave_trip_points (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    documentation_file_uuid     BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES documentation_files(uuid),
    cave_trip_point_uuid        BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES cave_trip_points(uuid),
    created_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(documentation_file_uuid, cave_trip_point_uuid) ON CONFLICT ROLLBACK
);

-- Table: media_qr_scan_cache (local only, NOT synced)
-- What reading each device picture for a QR label found, so that opening
-- the points-from-pictures screen again does not decode the same pictures
-- again. media_key identifies one version of one picture on this device
-- (see TripMediaSource.scanKey); qr_payload is the label's whole raw text,
-- or NULL when the picture was read and holds no code. Only the payload is
-- kept, never the place it matched: places and their codes can change, so
-- the match is made afresh each time. Device-specific keys mean nothing
-- elsewhere, so the table is absent from the sync registry.
CREATE TABLE IF NOT EXISTS media_qr_scan_cache (
    media_key                   TEXT PRIMARY KEY NOT NULL,
    qr_payload                  TEXT,
    scanned_at                  INTEGER NOT NULL
);

-- Table: cave_place_beacons
-- BLE tag registrations: maps a physical tag to a cave place, the beacon
-- analogue of a QR label. Two tag kinds share the table, discriminated by
-- beacon_type: 'ibeacon' (identity = proximity UUID + major + minor,
-- treated as opaque — hardware tests showed the vendor's MAC-derivation
-- rule does not hold) and 'ruuvi' (identity = payload MAC). Identity
-- uniqueness per cave is enforced by the partial indexes below, scoped to
-- active rows: unregistering is a soft delete, and a deleted registration
-- must not block re-registering the same tag elsewhere in the cave.
-- Health columns (last_*) are local telemetry refreshed on each
-- encounter; title/notes are user-facing tag documentation.
CREATE TABLE IF NOT EXISTS cave_place_beacons (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    cave_place_uuid             BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES cave_places(uuid),
    cave_uuid                   BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES caves(uuid),
    beacon_type                 TEXT(16) NOT NULL DEFAULT 'ibeacon',
    proximity_uuid              TEXT(36),          -- canonical uppercase 8-4-4-4-12; NULL for ruuvi
    major                       INTEGER,           -- NULL for ruuvi
    minor                       INTEGER,           -- NULL for ruuvi
    mac_address                 TEXT(17),          -- AA:BB:CC:DD:EE:FF; Ruuvi identity (payload-sourced)
    local_name                  TEXT(32),          -- BP1003 name (K02109b) / Ruuvi name (Ruuvi 884F)
    model                       TEXT(32),          -- free text: HCBB22 / H8 / RuuviTag Pro 3in1 / ...
    measured_power              INTEGER,           -- advertised RSSI@1m, for proximity calc
    firmware_version            TEXT(32),          -- read via DIS during Ruuvi history download
    title                       TEXT(64),          -- user-facing tag name (tag management)
    notes                       TEXT,
    last_seen_at                INTEGER,
    last_battery_mv             INTEGER,
    last_temperature_c          REAL,
    last_humidity_pct           REAL,
    last_pressure_hpa           REAL,
    last_movement_counter       INTEGER,
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid)
);

-- Identity uniqueness per cave, one guard per tag kind, active rows only
-- (see the table comment). Constraint-bearing, so they live here for
-- fresh installs; the v17→v18 migration creates the same indexes for
-- upgraders.
CREATE UNIQUE INDEX IF NOT EXISTS idx_cave_place_beacons_ibeacon
    ON cave_place_beacons(proximity_uuid, major, minor, cave_uuid)
    WHERE beacon_type = 'ibeacon' AND deleted_at IS NULL;
CREATE UNIQUE INDEX IF NOT EXISTS idx_cave_place_beacons_ruuvi
    ON cave_place_beacons(mac_address, cave_uuid)
    WHERE beacon_type = 'ruuvi' AND deleted_at IS NULL;

-- Lookup indexes (detection resolves identities on every trigger).
CREATE INDEX IF NOT EXISTS idx_cave_place_beacons_identity
    ON cave_place_beacons(proximity_uuid, major, minor);
CREATE INDEX IF NOT EXISTS idx_cave_place_beacons_place
    ON cave_place_beacons(cave_place_uuid);

-- Table: ruuvi_sensor_history
-- Downloaded Ruuvi on-tag measurement history. Local-only telemetry like
-- `configurations`: never change-logged, never exported by sync/archive —
-- sharing happens via CSV export. Keyed by the physical tag's MAC (not
-- the registration uuid) so history survives unregister/re-register and
-- cave moves. Wide rows merge the per-sensor log streams that share one
-- timestamp; the PK makes re-downloads idempotent upserts.
CREATE TABLE IF NOT EXISTS ruuvi_sensor_history (
    mac_address     TEXT(17) NOT NULL,
    measured_at     INTEGER NOT NULL,  -- Unix epoch seconds (tag log timestamps)
    temperature_c   REAL,
    humidity_pct    REAL,
    pressure_hpa    REAL,
    PRIMARY KEY(mac_address, measured_at)
);

-- Table: trip_report_templates
CREATE TABLE IF NOT EXISTS trip_report_templates (
    uuid                        BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    title                       TEXT(255) NOT NULL,
    file_name                   TEXT(255) NOT NULL,
    file_size                   INTEGER NOT NULL,
    format                      TEXT(10) NOT NULL,
    created_at                  INTEGER,
    updated_at                  INTEGER,
    deleted_at                  INTEGER,
    created_by_user_uuid        BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    last_modified_by_user_uuid  BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    UNIQUE(title) ON CONFLICT ROLLBACK
);

-- Table: change_log
-- Structured audit log. One row per repository-layer write operation.
-- Synced across devices; auto-purged locally past the retention threshold
-- (see `configurations.change_log_retention_days`).
--
-- change_type:  1 = insert, 2 = update, 3 = delete (soft-delete)
CREATE TABLE IF NOT EXISTS change_log (
    uuid                 BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    entity_table         TEXT(80) NOT NULL,
    entity_uuid          BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    change_type          INTEGER NOT NULL,
    changed_at           INTEGER NOT NULL,
    changed_by_user_uuid BLOB MAPPED BY `const UuidConverter()` REFERENCES users(uuid),
    device_uuid          BLOB MAPPED BY `const UuidConverter()`
);

-- Table: change_log_field
-- Per-field old-value forensics for a given change_log entry. Only the
-- old_value is stored (current state is in the entity row itself).
-- Values larger than 20 bytes are truncated: `old_value_short` is NULL and
-- `old_value_truncated` is set to 1.
CREATE TABLE IF NOT EXISTS change_log_field (
    change_uuid          BLOB NOT NULL MAPPED BY `const UuidConverter()` REFERENCES change_log(uuid) ON DELETE CASCADE,
    field_name           TEXT(80) NOT NULL,
    old_value_short      BLOB,
    old_value_truncated  INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (change_uuid, field_name)
);

-- Indexes for change_log lookups
CREATE INDEX IF NOT EXISTS idx_change_log_entity        ON change_log(entity_table, entity_uuid);
CREATE INDEX IF NOT EXISTS idx_change_log_changed_at    ON change_log(changed_at);
CREATE INDEX IF NOT EXISTS idx_change_log_changed_by    ON change_log(changed_by_user_uuid);

-- Table: silexgis_sync_state
-- LOCAL ONLY, like `configurations` and `ruuvi_sensor_history`: never
-- change-logged, never carried by device-to-device sync, never written into
-- an FTP archive.
--
-- The download cursor is a fact about ONE device's conversation with ONE
-- installation. An archive that carried one to a second device would have
-- that device send a position issued against data it never read; the server
-- answers "nothing after this" and the rows in between are never downloaded,
-- silently, with no error anywhere and nothing to retry.
--
-- `cursor` is opaque — store it, send it back, never parse it. `set_revision`
-- is the counter the last page carried: when it moves, every cursor issued
-- before it is retired and the set is read from the beginning.
CREATE TABLE IF NOT EXISTS silexgis_sync_state (
    profile_uuid    TEXT(36) NOT NULL,   -- the local server profile, not an account
    set_id          TEXT(36) NOT NULL,   -- the sync set on that installation
    cursor          TEXT,
    set_revision    INTEGER,
    last_synced_at  INTEGER,
    PRIMARY KEY (profile_uuid, set_id)
);

-- Table: silexgis_row_revision
-- LOCAL ONLY, for the same reason and with the same consequence: a base
-- revision that travelled to a second device makes that device lose every
-- upload to a conflict it cannot explain.
--
-- `entity_uuid` is BOTH the local identity and the server's — the device mints
-- the identifier and the server adopts it verbatim, and for a row the device
-- first meets by download it adopts the server's the same way. This is
-- deliberately NOT a mapping table and must never become one.
--
-- A row with an entry here exists on that installation, and the entry is what
-- its next upload sends as `baseRevision`. A row with no entry is new there.
--
-- `wire_kind` is kept because a local delete is physical: once the row is gone
-- the device can no longer tell whether it was an entrance or a place inside
-- the cave, and the tombstone it sends still has to name a kind.
--
-- `local_updated_at` is the local row's own `updated_at` at the moment the two
-- sides last agreed about it. A row is due to be sent again when its stamp no
-- longer equals this one — an exact comparison, with no clock and no window,
-- so an edit in the same millisecond as an upload is neither missed nor
-- re-sent for ever.
CREATE TABLE IF NOT EXISTS silexgis_row_revision (
    profile_uuid  TEXT(36) NOT NULL,
    entity_uuid   BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    entity_table  TEXT(80) NOT NULL,  -- which local table holds the row
    wire_kind        TEXT(16),        -- the `kind` this row travels as
    revision         TEXT NOT NULL,   -- the server's `updatedAt`, stored verbatim
    local_updated_at INTEGER,         -- the local row's own updated_at, as last exchanged
    updated_at       INTEGER,         -- when this device stored the entry
    PRIMARY KEY (profile_uuid, entity_uuid)
);

CREATE INDEX IF NOT EXISTS idx_silexgis_row_revision_table
    ON silexgis_row_revision(profile_uuid, entity_table);

-- Table: silexgis_stream_cursor
-- LOCAL ONLY, for the same reason as `silexgis_sync_state`: a cursor that
-- travelled to a second device would have it ask for everything after a
-- position it never read.
--
-- One resume position per stream of a sync set — documents, trips, rasters,
-- reviews. Each stream's cursor is its own: a position one stream issued is
-- refused as `sync.cursor_invalid` by every other, so a refusal drops only the
-- cursor refused. The feature download keeps its position in
-- `silexgis_sync_state`.
CREATE TABLE IF NOT EXISTS silexgis_stream_cursor (
    profile_uuid    TEXT(36) NOT NULL,   -- the local server profile, not an account
    set_id          TEXT(36) NOT NULL,   -- the sync set on that installation
    stream          TEXT(32) NOT NULL,   -- the stream's route name
    cursor          TEXT,                -- opaque; null reads from the beginning
    set_revision    INTEGER,
    last_synced_at  INTEGER,
    PRIMARY KEY (profile_uuid, set_id, stream)
);

-- Table: silexgis_held_row
-- LOCAL ONLY, like the other `silexgis_*` tables: a review is a fact about one
-- account's uploads to one installation, and nothing a second device could act
-- on.
--
-- One entry per local row an installation answered `held` — kept as a proposal
-- for a reviewer rather than written — keyed by the upload section it went in,
-- so sections other than feature rows can be held the same way.
--
-- `sent_local_updated_at` is the row's own `updated_at` as it was sent. While
-- the row still carries that stamp it is not sent again: the server would
-- answer the same review, or, once a reviewer has decided, replace the decision
-- with a new proposal. An edit moves the stamp, and the edited row is sent.
--
-- `outcome` is null while the proposal waits. `rejected` and `failed` are kept,
-- with the reviewer's `note`, the `code` of a failure and the server's own row
-- (`current_json`, when it may be handed over), until the caver chooses what
-- to do; `kept_at` records that they chose to keep their version unsent. An
-- accepted proposal is not kept: its revision becomes the row's base revision.
--
-- A row an upload answered with a conflict — or, for a pin, with another pin
-- already marking its place — is recorded here too, with `outcome` `conflict`,
-- the answer's `code`, an empty `review_id` and the server's row when the
-- answer echoed it. Like a decided proposal it waits for the caver, and while
-- it still carries the stamp it was sent at it is neither sent again nor
-- overwritten by a read.
CREATE TABLE IF NOT EXISTS silexgis_held_row (
    profile_uuid          TEXT(36) NOT NULL,
    section               TEXT(32) NOT NULL,   -- the upload array the row went in
    entity_uuid           BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    entity_table          TEXT(80) NOT NULL,   -- which local table holds the row
    wire_kind             TEXT(16),            -- the `kind` it travelled as
    review_id             TEXT(36) NOT NULL,   -- the proposal the upload answered with
    is_delete             BOOLEAN NOT NULL DEFAULT 0,  -- the proposal is a removal
    sent_local_updated_at INTEGER,             -- the row's updated_at as sent
    held_at               INTEGER,             -- when this device was told
    outcome               TEXT(16),            -- null while waiting
    note                  TEXT,                -- what the reviewer wrote
    code                  TEXT(80),            -- why a `failed` row could not be written
    decided_at            TEXT,                -- the server's stamp, verbatim
    current_json          TEXT,                -- the server's row, as the stream shapes it
    kept_at               INTEGER,             -- the caver chose to keep their version
    PRIMARY KEY (profile_uuid, section, entity_uuid)
);

CREATE INDEX IF NOT EXISTS idx_silexgis_held_row_review
    ON silexgis_held_row(profile_uuid, review_id);

-- Table: silexgis_person
-- LOCAL ONLY. The installation's people directory as this account was last
-- shown it: the cavers a phone user may be said to be. Names only — the
-- directory carries no contact details — and replaced whole on every read.
-- Emptied when the installation stops offering the directory, which is also
-- what hides the choice of caver.
CREATE TABLE IF NOT EXISTS silexgis_person (
    profile_uuid  TEXT(36) NOT NULL,
    caver_id      TEXT(36) NOT NULL,
    full_name     TEXT NOT NULL,
    short_name    TEXT,
    has_account   BOOLEAN NOT NULL DEFAULT 0,
    is_me         BOOLEAN NOT NULL DEFAULT 0,
    PRIMARY KEY (profile_uuid, caver_id)
);

-- Table: silexgis_person_link
-- LOCAL ONLY. Which caver each phone user is on one installation, and what was
-- last said about the user there.
--
-- `caver_id` is the link as it stands: the phone's own choice until a read of
-- the directory says otherwise, because a link made in the browser wins.
-- `link_source` says which (`phone` or `server`). `choice_pending` marks a
-- choice made here and not yet sent. `sent_names_hash` digests the names last
-- sent, so a renamed user is sent again and an unchanged one is not.
CREATE TABLE IF NOT EXISTS silexgis_person_link (
    profile_uuid     TEXT(36) NOT NULL,
    user_uuid        BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    caver_id         TEXT(36),
    link_source      TEXT(8),
    choice_pending   BOOLEAN NOT NULL DEFAULT 0,
    sent_names_hash  TEXT(64),
    sent_at          INTEGER,
    PRIMARY KEY (profile_uuid, user_uuid)
);

-- Table: silexgis_document
-- LOCAL ONLY. The documents of an installation's photo and document catalogue,
-- as this account was last shown them: metadata only. Nothing in it means a
-- file is on this device, and nothing is fetched because a row is here.
--
-- `title` is the server's full title. The local `documentation_files.title`
-- holds 50 characters, so a longer one is cut there; comparing the two is how
-- an upload tells a title the caver changed from one only the cut changed.
-- `renditions` lists the picture sizes the server draws, comma-separated,
-- largest first. `size_bytes` and `sha256` describe the stored file and are
-- absent where fetching it would hand over other bytes (`reach` locationFree).
-- `created_by_device_user_id` is the phone user who sent it, where the server
-- says.
CREATE TABLE IF NOT EXISTS silexgis_document (
    profile_uuid              TEXT(36) NOT NULL,
    document_id               BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    version_id                TEXT(36),
    title                     TEXT NOT NULL,
    description               TEXT,
    file_kind                 TEXT(16) NOT NULL,
    mime_type                 TEXT(127),
    size_bytes                INTEGER,
    sha256                    TEXT(64),
    reach                     TEXT(16) NOT NULL,
    renditions                TEXT,
    captured_at               TEXT,
    updated_at                TEXT,
    created_by_device_user_id TEXT(36),
    PRIMARY KEY (profile_uuid, document_id)
);

-- Table: silexgis_document_link
-- LOCAL ONLY. One catalogue row: a document hung on one feature, with the role,
-- caption and order it has there. A tombstone on the documents stream removes
-- the row; the document's own row goes with its last link.
CREATE TABLE IF NOT EXISTS silexgis_document_link (
    profile_uuid    TEXT(36) NOT NULL,
    link_id         TEXT(36) NOT NULL,
    document_id     BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    target_kind     TEXT(16) NOT NULL,
    target_id       BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    role            TEXT(24),
    caption         TEXT,
    sort_order      INTEGER NOT NULL DEFAULT 0,
    is_primary      BOOLEAN NOT NULL DEFAULT 0,
    in_default_set  BOOLEAN NOT NULL DEFAULT 0,
    revision        TEXT,
    PRIMARY KEY (profile_uuid, link_id)
);

CREATE INDEX IF NOT EXISTS idx_silexgis_document_link_target
    ON silexgis_document_link(profile_uuid, target_id);

CREATE INDEX IF NOT EXISTS idx_silexgis_document_link_document
    ON silexgis_document_link(profile_uuid, document_id);

-- Table: silexgis_file_copy
-- LOCAL ONLY. What a documentation file on this device is a copy of, for every
-- file that is not simply the caver's own: `held_as` is `own`, `original` (the
-- server's stored file, byte for byte), `locationFree` (the whole picture with
-- its location data removed) or `rendition` (a picture the server drew,
-- `rendition` pixels across); `origin` is `device`, `archive` or `server`.
--
-- A file with no row here is the device's own. A server copy never replaces a
-- file the device holds, is never sent back up as its original, and a
-- `locationFree` copy or a rendition stays out of device-to-device archives.
CREATE TABLE IF NOT EXISTS silexgis_file_copy (
    document_uuid  BLOB PRIMARY KEY NOT NULL MAPPED BY `const UuidConverter()`,
    version_id     TEXT(36),
    held_as        TEXT(16) NOT NULL,
    rendition      INTEGER,
    origin         TEXT(8) NOT NULL,
    recorded_at    INTEGER
);

-- Table: silexgis_staged_upload
-- LOCAL ONLY. The bytes of a documentation file sent ahead of the upload that
-- names them, per installation: the transfer they travel in, how far they got,
-- and what became of them. `state` is `sending` while pieces still go,
-- `staged` once completed and waiting for a document row to adopt them until
-- `expires_at`, and `adopted` once a row made them the document's file — then
-- `sha256` is the content the installation holds for the document, and a file
-- whose hash differs has new bytes to send.
CREATE TABLE IF NOT EXISTS silexgis_staged_upload (
    profile_uuid    TEXT(36) NOT NULL,
    document_uuid   BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    sha256          TEXT(64) NOT NULL,
    size_bytes      INTEGER NOT NULL,
    transfer_id     TEXT(36),
    received_bytes  INTEGER NOT NULL DEFAULT 0,
    expires_at      TEXT,
    state           TEXT(16) NOT NULL,
    updated_at      INTEGER,
    PRIMARY KEY (profile_uuid, document_uuid)
);

-- Table: silexgis_server_link
-- LOCAL ONLY. Each document link an installation holds, as this device knows
-- it: hung by this device's upload, or read from the catalogue for a file
-- fetched from it. A link is named by its document and its target together,
-- so that pair is the key; `link_id` is the installation's own identifier for
-- it. An entry whose local link row is gone is a removal still to be sent.
CREATE TABLE IF NOT EXISTS silexgis_server_link (
    profile_uuid    TEXT(36) NOT NULL,
    document_uuid   BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    target_kind     TEXT(16) NOT NULL,
    target_id       BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    link_id         TEXT(36),
    updated_at      INTEGER,
    PRIMARY KEY (profile_uuid, document_uuid, target_id)
);

-- Table: silexgis_trip_entry
-- LOCAL ONLY. What this device knows about a trip recording or one of its
-- scans on one installation, beyond the revision `silexgis_row_revision`
-- keeps.
--
-- `recording_uuid` is the recording itself for a recording, and the scan's
-- recording for a scan — kept because a local delete is physical, and a scan's
-- removal still has to name its recording once the row is gone.
-- `received` marks a row first met by download. Another phone made it, not
-- this device, which is how the trips list tells the installation's
-- recordings from this device's own.
-- `sent` marks a row this device has sent. A scan missing from its
-- recording's list is removed here only when it was received and never sent,
-- because a scan of a withheld place is missing exactly as a removed one is.
-- `author_device_user_id` is the phone user the installation names as the
-- author when no user on this device is that one. The row's own foreign key
-- stays null, and the id is kept here rather than sent back, so an edit never
-- states a different author.
CREATE TABLE IF NOT EXISTS silexgis_trip_entry (
    profile_uuid           TEXT(36) NOT NULL,
    entity_uuid            BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    recording_uuid         BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    is_scan                BOOLEAN NOT NULL DEFAULT 0,
    received               BOOLEAN NOT NULL DEFAULT 0,
    sent                   BOOLEAN NOT NULL DEFAULT 0,
    author_device_user_id  TEXT(36),
    PRIMARY KEY (profile_uuid, entity_uuid)
);

CREATE INDEX IF NOT EXISTS idx_silexgis_trip_entry_recording
    ON silexgis_trip_entry(profile_uuid, recording_uuid);

-- Table: silexgis_raster_entry
-- LOCAL ONLY. What this device knows about a raster map or one of its pins on
-- one installation, beyond the revision `silexgis_row_revision` keeps.
--
-- `map_uuid` is the map itself for a map, and the pin's map for a pin — kept
-- because a local delete is physical, and a pin's removal still has to name
-- its map once the row is gone.
-- `received` marks a row first met by download, and `sent` a row this device
-- has sent. A pin missing from its map's list is removed here only when it
-- was received and never sent, because a pin of a withheld place is missing
-- exactly as a removed one is.
-- `document_id` is the installation's document holding the map's picture.
-- `picture_sha256` is the hash of the local picture that stands for the
-- installation's current one — the bytes fetched or sent — so a picture is
-- sent again only when the caver gave the map another, and a copy fetched
-- without its location data never goes back up. Null while the picture is
-- still to fetch. `picture_version` is the catalogue's revision of those
-- bytes, when known.
-- `area_id` is the area the installation names when this device holds no
-- such area: the row's own column stays null, and the id is sent back so an
-- edit never clears it there.
-- `picture_width` and `picture_height` are the pixel size of the map's
-- picture as the installation stores it — the frame its pins are measured
-- in — and `picture_mirrored` and `picture_turn` (clockwise degrees, after
-- the flip) how its upright renditions are drawn from it. Each is null when
-- the installation does not say; a pin row leaves them null.
CREATE TABLE IF NOT EXISTS silexgis_raster_entry (
    profile_uuid     TEXT(36) NOT NULL,
    entity_uuid      BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    map_uuid         BLOB NOT NULL MAPPED BY `const UuidConverter()`,
    is_pin           BOOLEAN NOT NULL DEFAULT 0,
    received         BOOLEAN NOT NULL DEFAULT 0,
    sent             BOOLEAN NOT NULL DEFAULT 0,
    document_id      BLOB MAPPED BY `const UuidConverter()`,
    picture_version  TEXT(36),
    picture_sha256   TEXT(64),
    area_id          BLOB MAPPED BY `const UuidConverter()`,
    picture_width    INTEGER,
    picture_height   INTEGER,
    picture_mirrored BOOLEAN,
    picture_turn     INTEGER,
    PRIMARY KEY (profile_uuid, entity_uuid)
);

CREATE INDEX IF NOT EXISTS idx_silexgis_raster_entry_map
    ON silexgis_raster_entry(profile_uuid, map_uuid);
