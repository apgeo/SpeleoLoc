<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only to the loopback address: the 3D model viewer's WebView
     loads its page and the survey from a server the app runs on 127.0.0.1
     while the viewer is open. Every other host keeps the platform default,
     HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
