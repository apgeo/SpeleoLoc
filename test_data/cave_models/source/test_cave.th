encoding utf-8
# Invented survey for tests: no real cave, every value made up.

survey test_cave -title "Test Cave (invented)"

  survey main -title "Main passage"
    centreline
      date 2026.11.01
      team "Test Surveyor"
      units length meters
      units compass clino degrees
      fix 0 0 0 0
      station 0 "Entrance" entrance
      data normal from to length compass clino left right up down
      0 1  5.20  90 -10  1.0 1.2 2.0 0.5
      1 2  7.80 120 -25  0.8 1.5 3.0 0.4
      2 3  6.10 135  -5  2.0 2.5 4.0 0.6
      3 4  9.40 160 -40  1.5 1.0 6.0 1.0
      4 5  4.30 200   0  3.0 3.5 5.0 0.8
      5 6  8.70 230  12  1.2 0.9 2.5 0.3
      station 3 "Chamber"
      station 6 "Sump"
      data normal from to length compass clino
      flags splay
      2 - 2.10  40   5
      2 - 1.70 220  10
      3 - 3.30  60  20
      3 - 2.90 250  35
      3 - 4.10 140  80
      flags not splay
    endcentreline
  endsurvey

  survey side -title "Side branch"
    centreline
      units length meters
      units compass clino degrees
      data normal from to length compass clino left right up down
      0 1  3.50  10  15  0.6 0.7 1.5 0.2
      1 2  6.20 350  30  0.5 0.5 2.0 0.3
      2 3  4.80  20  -5  0.9 1.1 1.8 0.4
      station 3 "Window"
    endcentreline
  endsurvey

  equate 4@main 0@side

endsurvey
