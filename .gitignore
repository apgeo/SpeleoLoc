# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Created by direct gradlew invocations (flutter builds use /build/)
/android/build/

# Local IDE cache
.vs/

# Local runtime databases (keep SQL schema dumps tracked)
/db/*.db
/db/*.db.old
/db/*.sqlite

# Keep test fixtures tracked, ignore only generated app test outputs
/test_data/app_tests/
/test_output.txt

# CI workflows are tracked; only local prompt/agent scratch dirs stay ignored
.github/prompts/
.github/agents/
test_data/pictures/

# for now contributing-docs.md is not in public repo
docs/contributing-docs.md
docs/ro/contributing-docs.md

# Live-integration FTP credentials (opt-in, never committed)
test_data/ftp_test.json

# Build-settings files that carry a seeded sync account's password
# (--dart-define-from-file). Machine-local like android/key.properties; see
# docs/workflows/seeded-sync-profile.md for the keys.
/build_settings.*.local.json
/build_settings.congres.json

# Local test-archive dev workflow: the heavy DataArchive zip(s) dropped here
# are machine-local and never committed; the tracked .gitkeep keeps the
# bundled-asset directory present on fresh clones. See
# docs/workflows/local-test-archive.md.
/assets/test_archive/*
!/assets/test_archive/.gitkeep

/resource_docs/
.claude/
