{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // The "speleo_loc @ <device>" entries each target one AVD from
    // tool/android/avd.sh; `tool/android/avd.sh doctor` says whether this
    // machine can run them. They launch with build_settings.json, which
    // loads the real cave register --- fine for working by hand, never to
    // be used for automated runs or screenshots (see
    // docs/workflows/android-emulator-and-ui-testing.md).

    "version": "0.3.1",
    "configurations": [
        {
            "name": "speleo_loc",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=build_settings.json"
            ]
        },
        {
            "name": "speleo_loc (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=build_settings.json"
            ]
        },
        {
            "name": "speleo_loc (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=build_settings.json",
                "--dart-define=DEV_TOOLS=true"
            ]
        },
        {
            "name": "speleo_loc (store build)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=build_settings.store.json"
            ]
        },
        {
            "name": "speleo_loc (congres hand-out build)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=build_settings.congres.json"
            ]
        },
        {
            "name": "speleo_loc_local_archive",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=build_settings_local_archive.json"
            ]
        },
        {
            "name": "speleo_loc @ Pixel 2 · API 24 (minSdk)",
            "request": "launch",
            "type": "dart",
            "deviceId": "speleo_api24_pixel2",
            "toolArgs": [
                "--dart-define-from-file=build_settings.json"
            ]
        },
        {
            "name": "speleo_loc @ Pixel 4 · API 30",
            "request": "launch",
            "type": "dart",
            "deviceId": "speleo_api30_pixel4",
            "toolArgs": [
                "--dart-define-from-file=build_settings.json"
            ]
        },
        {
            "name": "speleo_loc @ Pixel 7 · API 34 (media permissions)",
            "request": "launch",
            "type": "dart",
            "deviceId": "speleo_api34_pixel7",
            "toolArgs": [
                "--dart-define-from-file=build_settings.json"
            ]
        },
        {
            "name": "speleo_loc @ Tablet · API 34",
            "request": "launch",
            "type": "dart",
            "deviceId": "speleo_api34_tablet",
            "toolArgs": [
                "--dart-define-from-file=build_settings.json"
            ]
        },
        {
            "name": "speleo_loc @ Pixel 7 Pro · API 36",
            "request": "launch",
            "type": "dart",
            "deviceId": "speleo_api36_pixel7pro",
            "toolArgs": [
                "--dart-define-from-file=build_settings.json"
            ]
        }
    ]
}
