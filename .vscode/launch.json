{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.3.1",
    "configurations": [
        {
            "name": "speleo_loc",
            "request": "launch",
            "type": "dart",
            "toolArgs": ["--dart-define-from-file=build_settings.json"]
        },
        {
            "name": "speleo_loc (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": ["--dart-define-from-file=build_settings.json"]
        },
        {
            "name": "speleo_loc (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=build_settings.json",
                "--dart-define=DEV_TOOLS=true"
            ]
        },
        {
            "name": "speleo_loc (store build)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": ["--dart-define-from-file=build_settings.store.json"]
        },
        {
            "name": "speleo_loc_local_archive",
            "request": "launch",
            "type": "dart",
            "toolArgs": ["--dart-define-from-file=build_settings_local_archive.json"]
        }
    ]
}